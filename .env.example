# Copy to .env.local for local development. Never commit a filled-in copy:
# .gitignore covers every .env filename except this one, and the repo is public.
#
# In production these are set in Vercel (Settings > Environment Variables),
# not from a file. Changing one there needs a redeploy to take effect.

# Required for the contact form to deliver. Without it /api/contact returns 503
# and the form points the reader at the email address instead.
RESEND_API_KEY=

# Optional. Where enquiries land. Defaults to hannahfeehan.dev@gmail.com.
CONTACT_TO=

# Optional. The sender address. Must be on a domain verified in Resend, or the
# send fails. Defaults to contact@hfdesign.co.uk.
CONTACT_FROM=
